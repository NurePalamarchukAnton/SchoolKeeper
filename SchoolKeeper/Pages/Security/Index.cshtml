@page
@model SchoolKeeper.Pages.Security.IndexModel
@{
    ViewData["Title"] = "Security Dashboard";
}

<div class="container-fluid">
    <h1 class="mb-4">Панель охорони</h1>

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Всього пристроїв</h5>
                    <h2 class="mb-0">@Model.TotalDevices</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Активні пристрої</h5>
                    <h2 class="mb-0">@Model.ActiveDevices</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h5 class="card-title">Неактивні пристрої</h5>
                    <h2 class="mb-0">@Model.InactiveDevices</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Активні інциденти</h5>
                    <h2 class="mb-0">@Model.ActiveIncidents</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-secondary">
                <div class="card-body">
                    <h5 class="card-title">Вирішені інциденти</h5>
                    <h2 class="mb-0">@Model.ResolvedIncidents</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-dark">
                <div class="card-body">
                    <h5 class="card-title">Звіти</h5>
                    <h2 class="mb-0">@Model.TotalReports</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">
                    <h5>Швидкі дії</h5>
                </div>
                <div class="card-body">
                    <a asp-page="/Devices/Index" class="btn btn-info mb-2">Управління пристроями</a><br>
                    <a asp-page="/Incidents/Index" class="btn btn-warning mb-2">Управління інцидентами</a><br>
                    <a asp-page="/Reports/Create" class="btn btn-primary mb-2">Створити звіт</a><br>
                    <a asp-page="/Reports/Index" class="btn btn-secondary mb-2">Перегляд звітів</a>
                </div>
            </div>
        </div>
    </div>
</div>

