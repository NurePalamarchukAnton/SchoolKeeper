@page
@model SchoolKeeper.Pages.Incidents.EditModel
@{
    ViewData["Title"] = "Редагувати інцидент";
    ViewData["I18nPage"] = "incidentEdit";
}

<div class="container">
    <h2 data-i18n="incidents.editTitle">Редагувати інцидент</h2>

    <form method="post">
        <div class="mb-3">
            <label asp-for="Incident.DeviceId" class="form-label" data-i18n="incidents.lbl.device">Пристрій</label>
            <select asp-for="Incident.DeviceId" asp-items="Model.Devices" class="form-select">
                <option value="" data-i18n="incidents.selectDevice">-- Оберіть пристрій --</option>
            </select>
            <span asp-validation-for="Incident.DeviceId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Incident.IncidentType" class="form-label" data-i18n="incidents.lbl.incidentType">Тип інциденту</label>
            <input asp-for="Incident.IncidentType" class="form-control" value="@Model.CurrentIncident.IncidentType" />
            <span asp-validation-for="Incident.IncidentType" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Incident.Severity" class="form-label" data-i18n="admin.th.severity">Серйозність</label>
            <select asp-for="Incident.Severity" asp-items="Model.Severities" class="form-select">
                <option value="" data-i18n="incidents.selectSeverity">-- Оберіть серйозність --</option>
            </select>
            <span asp-validation-for="Incident.Severity" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Incident.Description" class="form-label" data-i18n="admin.lbl.description">Опис</label>
            <textarea asp-for="Incident.Description" class="form-control" rows="3">@Model.CurrentIncident.Description</textarea>
            <span asp-validation-for="Incident.Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Incident.Status" class="form-label" data-i18n="admin.th.status">Статус</label>
            <select asp-for="Incident.Status" asp-items="Model.Statuses" class="form-select">
                <option value="" data-i18n="incidents.selectStatus">-- Оберіть статус --</option>
            </select>
            <span asp-validation-for="Incident.Status" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary" data-i18n="common.save">Зберегти</button>
            <a asp-page="Index" class="btn btn-secondary" data-i18n="common.cancel">Скасувати</a>
        </div>
    </form>
</div>
