@page
@model SchoolKeeper.Pages.Incidents.IndexModel
@{
    ViewData["Title"] = "Інциденти";
    ViewData["I18nPage"] = "incidents";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 data-i18n="incidents.title">Інциденти</h1>
        @if (Model.CanCreate)
        {
            <a asp-page="Create" class="btn btn-primary" data-i18n="incidents.create">Створити інцидент</a>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th data-i18n="incidents.th.type">Тип</th>
                    <th data-i18n="incidents.th.severity">Серйозність</th>
                    <th data-i18n="incidents.th.device">Пристрій</th>
                    <th data-i18n="incidents.th.date">Дата</th>
                    <th data-i18n="incidents.th.status">Статус</th>
                    <th data-i18n="incidents.th.actions">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var incident in Model.Incidents)
                {
                    <tr>
                        <td>@incident.IncidentType</td>
                        <td>
                            <span class="badge @(incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.Critical ? "bg-danger" : 
                                incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.High ? "bg-warning" : 
                                incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.Medium ? "bg-info" : "bg-secondary")">
                                <span data-i18n="enum.IncidentSeverity.@incident.Severity">@incident.Severity</span>
                            </span>
                        </td>
                        <td>@incident.DeviceId</td>
                        <td>@incident.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <span class="badge @(incident.Status == SchoolKeeper.Models.Enums.IncidentStatus.Active ? "bg-warning" : "bg-success")">
                                <span data-i18n="enum.IncidentStatus.@incident.Status">@incident.Status</span>
                            </span>
                        </td>
                        <td>
                            <a asp-page="Details" asp-route-id="@incident.Id" class="btn btn-sm btn-info" data-i18n="common.details">Деталі</a>
                            @if (Model.CanEdit)
                            {
                                <a asp-page="Edit" asp-route-id="@incident.Id" class="btn btn-sm btn-warning" data-i18n="common.edit">Редагувати</a>
                            }
                            @if (Model.CanResolve && incident.Status == SchoolKeeper.Models.Enums.IncidentStatus.Active)
                            {
                                <form method="post" asp-page-handler="Resolve" asp-route-id="@incident.Id" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success" data-i18n="common.resolve">Вирішити</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
