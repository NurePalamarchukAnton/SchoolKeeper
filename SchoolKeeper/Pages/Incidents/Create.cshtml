@page
@model SchoolKeeper.Pages.Incidents.CreateModel
@{
    ViewData["Title"] = "Створити інцидент";
}

<div class="container">
    <h2>Створити інцидент</h2>

    <form method="post">
        <div class="mb-3">
            <label asp-for="Incident.DeviceId" class="form-label">Пристрій</label>
            <select asp-for="Incident.DeviceId" asp-items="Model.Devices" class="form-select" required></select>
            <span asp-validation-for="Incident.DeviceId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Incident.IncidentType" class="form-label">Тип інциденту</label>
            <input asp-for="Incident.IncidentType" class="form-control" required />
            <span asp-validation-for="Incident.IncidentType" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Incident.Severity" class="form-label">Серйозність</label>
            <select asp-for="Incident.Severity" asp-items="Model.Severities" class="form-select" required></select>
            <span asp-validation-for="Incident.Severity" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Incident.Description" class="form-label">Опис</label>
            <textarea asp-for="Incident.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Incident.Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Incident.Status" class="form-label">Статус</label>
            <select asp-for="Incident.Status" asp-items="Model.Statuses" class="form-select" required></select>
            <span asp-validation-for="Incident.Status" class="text-danger"></span>
        </div>

        <input type="hidden" asp-for="Incident.ReportedBy" />
        <input type="hidden" asp-for="Incident.SchoolId" />
        <input type="hidden" asp-for="Incident.Timestamp" />

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Створити</button>
            <a asp-page="Index" class="btn btn-secondary">Скасувати</a>
        </div>
    </form>
</div>


