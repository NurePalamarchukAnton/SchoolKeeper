@page
@model SchoolKeeper.Pages.Reports.EditModel
@{
    ViewData["Title"] = "Редагувати звіт";
    ViewData["I18nPage"] = "reportEdit";
}

<div class="container">
    <h2 data-i18n="reports.editTitle">Редагувати звіт</h2>

    <form method="post">
        @if (Model.IsAdmin)
        {
            <div class="mb-3">
                <label asp-for="Report.SchoolId" class="form-label" data-i18n="reports.dt.school">Школа</label>
                <select asp-for="Report.SchoolId" asp-items="Model.Schools" class="form-select">
                    <option value="" data-i18n="reports.selectSchool">-- Оберіть школу --</option>
                </select>
                <span asp-validation-for="Report.SchoolId" class="text-danger"></span>
            </div>
        }

        <div class="mb-3">
            <label asp-for="Report.PeriodStart" class="form-label" data-i18n="reports.lbl.periodStart">Період початку</label>
            <input asp-for="Report.PeriodStart" type="date" class="form-control" value="@Model.CurrentReport.PeriodStart.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="Report.PeriodStart" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Report.PeriodEnd" class="form-label" data-i18n="reports.lbl.periodEnd">Період кінця</label>
            <input asp-for="Report.PeriodEnd" type="date" class="form-control" value="@Model.CurrentReport.PeriodEnd.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="Report.PeriodEnd" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Report.Summary" class="form-label" data-i18n="reports.lbl.description">Опис</label>
            <textarea asp-for="Report.Summary" class="form-control" rows="5">@Model.CurrentReport.Summary</textarea>
            <span asp-validation-for="Report.Summary" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary" data-i18n="common.save">Зберегти</button>
            <a asp-page="Index" class="btn btn-secondary" data-i18n="common.cancel">Скасувати</a>
        </div>
    </form>
</div>
