@page
@model SchoolKeeper.Pages.Reports.DetailsModel
@{
    ViewData["Title"] = "Деталі звіту";
}

<div class="container">
    <h2>Деталі звіту</h2>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Школа</dt>
                <dd class="col-sm-9">@Model.SchoolName</dd>

                <dt class="col-sm-3">Період початку</dt>
                <dd class="col-sm-9">@Model.Report.PeriodStart.ToString("dd.MM.yyyy")</dd>

                <dt class="col-sm-3">Період кінця</dt>
                <dd class="col-sm-9">@Model.Report.PeriodEnd.ToString("dd.MM.yyyy")</dd>

                <dt class="col-sm-3">Створено</dt>
                <dd class="col-sm-9">@Model.Report.GeneratedOn.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-3">Автор</dt>
                <dd class="col-sm-9">@Model.GeneratorName</dd>

                @if (!string.IsNullOrEmpty(Model.Report.Summary))
                {
                    <dt class="col-sm-3">Зміст звіту</dt>
                    <dd class="col-sm-9">
                        <div class="report-summary">
                            <pre class="bg-light p-3 rounded border" style="white-space: pre-wrap; font-family: inherit; font-size: 0.9rem; line-height: 1.6;">@Model.Report.Summary</pre>
                        </div>
                    </dd>
                }
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Index" class="btn btn-secondary">Назад до списку</a>
        <button onclick="exportReport(@Model.Report.Id, 'txt')" class="btn btn-success">Скачати звіт (TXT)</button>
        <button onclick="exportReport(@Model.Report.Id, 'json')" class="btn btn-primary">Скачати звіт (JSON)</button>
        <button onclick="exportReport(@Model.Report.Id, 'csv')" class="btn btn-info">Скачати звіт (CSV)</button>
    </div>
</div>

<script>
    function getAuthToken() {
        // Спочатку пробуємо з cookie
        const cookies = document.cookie.split(';');
        for (let cookie of cookies) {
            const [name, value] = cookie.trim().split('=');
            if (name === 'authToken') {
                return value;
            }
        }
        // Якщо немає в cookie, пробуємо localStorage
        return localStorage.getItem('authToken');
    }

    async function exportReport(reportId, format) {
        const token = getAuthToken();
        if (!token) {
            alert('Помилка: Ви не авторизовані. Будь ласка, увійдіть в систему.');
            window.location.href = '/Login';
            return;
        }

        try {
            const response = await fetch(`/api/Rept/${reportId}/export?format=${format}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Accept': format === 'json' ? 'application/json' : format === 'csv' ? 'text/csv' : 'text/plain'
                }
            });

            if (!response.ok) {
                if (response.status === 401) {
                    alert('Помилка: Сесія закінчилася. Будь ласка, увійдіть в систему знову.');
                    window.location.href = '/Login';
                    return;
                }
                throw new Error(`Помилка завантаження: ${response.status} ${response.statusText}`);
            }

            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `report_${reportId}.${format}`;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
        } catch (error) {
            console.error('Помилка експорту:', error);
            alert('Помилка при завантаженні звіту: ' + error.message);
        }
    }
</script>


