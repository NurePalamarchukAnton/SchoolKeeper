@page
@model SchoolKeeper.Pages.Reports.DetailsModel
@{
    ViewData["Title"] = "Деталі звіту";
    ViewData["I18nPage"] = "reportDetails";
}

<div class="container">
    <h2 data-i18n="reports.detailsTitle">Деталі звіту</h2>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3" data-i18n="reports.dt.school">Школа</dt>
                <dd class="col-sm-9">@Model.SchoolName</dd>

                <dt class="col-sm-3" data-i18n="reports.lbl.periodStart">Період початку</dt>
                <dd class="col-sm-9">@Model.Report.PeriodStart.ToString("dd.MM.yyyy")</dd>

                <dt class="col-sm-3" data-i18n="reports.lbl.periodEnd">Період кінця</dt>
                <dd class="col-sm-9">@Model.Report.PeriodEnd.ToString("dd.MM.yyyy")</dd>

                <dt class="col-sm-3" data-i18n="reports.th.created">Створено</dt>
                <dd class="col-sm-9">@Model.Report.GeneratedOn.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-3" data-i18n="reports.th.author">Автор</dt>
                <dd class="col-sm-9">@Model.GeneratorName</dd>

                @if (!string.IsNullOrEmpty(Model.Report.Summary))
                {
                    <dt class="col-sm-3" data-i18n="reports.dt.summary">Зміст звіту</dt>
                    <dd class="col-sm-9">
                        <div class="report-summary">
                            <pre class="bg-light p-3 rounded border" style="white-space: pre-wrap; font-family: inherit; font-size: 0.9rem; line-height: 1.6;">@Model.Report.Summary</pre>
                        </div>
                    </dd>
                }
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Index" class="btn btn-secondary" data-i18n="common.backToList">Назад до списку</a>
        <button type="button" onclick="exportReport(@Model.Report.Id, 'txt')" class="btn btn-success" data-i18n="reports.downloadTxtLong">Скачати звіт (TXT)</button>
        <button type="button" onclick="exportReport(@Model.Report.Id, 'json')" class="btn btn-primary" data-i18n="reports.downloadJson">Скачати звіт (JSON)</button>
        <button type="button" onclick="exportReport(@Model.Report.Id, 'csv')" class="btn btn-info" data-i18n="reports.downloadCsv">Скачати звіт (CSV)</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/report-export.js" asp-append-version="true"></script>
}
