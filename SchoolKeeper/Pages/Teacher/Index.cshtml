@page
@model SchoolKeeper.Pages.Teacher.IndexModel
@{
    ViewData["Title"] = "Панель вчителя";
    ViewData["I18nPage"] = "teacher";
}

<div class="container-fluid">
    <h1 class="mb-4" data-i18n="teacher.title">Панель вчителя</h1>

    <ul class="nav nav-tabs mb-4" id="teacherTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="students-tab" data-bs-toggle="tab" data-bs-target="#students" type="button" role="tab">
                <span data-i18n="teacher.tab.students">Учні</span><span class="text-body-secondary"> (@Model.Students.Count)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="parents-tab" data-bs-toggle="tab" data-bs-target="#parents" type="button" role="tab">
                <span data-i18n="teacher.tab.parents">Батьки</span><span class="text-body-secondary"> (@Model.Parents.Count)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="incidents-tab" data-bs-toggle="tab" data-bs-target="#incidents" type="button" role="tab">
                <span data-i18n="teacher.tab.incidents">Інциденти</span><span class="text-body-secondary"> (@Model.Incidents.Count)</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="teacherTabContent">
        <div class="tab-pane fade show active" id="students" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0" data-i18n="teacher.studentsTitle">Мої учні</h5>
                </div>
                <div class="card-body">
                    @if (Model.Students.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th data-i18n="admin.th.fullName">ПІБ</th>
                                        <th data-i18n="admin.th.email">Email</th>
                                        <th data-i18n="admin.th.phone">Телефон</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model.Students)
                                    {
                                        <tr>
                                            <td>@student.FullName</td>
                                            <td>@student.Email</td>
                                            <td>@(student.PhoneNumber ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted" data-i18n="teacher.emptyStudents">У вас поки немає учнів</p>
                    }
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="parents" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0" data-i18n="teacher.parentsTitle">Батьки моїх учнів</h5>
                </div>
                <div class="card-body">
                    @if (Model.Parents.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th data-i18n="admin.th.fullName">ПІБ</th>
                                        <th data-i18n="admin.th.email">Email</th>
                                        <th data-i18n="admin.th.phone">Телефон</th>
                                        <th data-i18n="teacher.th.children">Діти</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var parent in Model.Parents)
                                    {
                                        <tr>
                                            <td>@parent.FullName</td>
                                            <td>@parent.Email</td>
                                            <td>@(parent.PhoneNumber ?? "-")</td>
                                            <td>
                                                @if (parent.ChildrenNames.Any())
                                                {
                                                    <span>@string.Join(", ", parent.ChildrenNames)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted" data-i18n="teacher.emptyParents">Немає інформації про батьків</p>
                    }
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="incidents" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0" data-i18n="teacher.incidentsTitle">Інциденти</h5>
                </div>
                <div class="card-body">
                    @if (Model.Incidents.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th data-i18n="incidents.th.type">Тип</th>
                                        <th data-i18n="incidents.th.severity">Серйозність</th>
                                        <th data-i18n="admin.lbl.description">Опис</th>
                                        <th data-i18n="incidents.th.date">Дата</th>
                                        <th data-i18n="incidents.th.status">Статус</th>
                                        <th data-i18n="incidents.th.actions">Дії</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var incident in Model.Incidents)
                                    {
                                        <tr>
                                            <td>@incident.IncidentType</td>
                                            <td>
                                                <span class="badge @(incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.Critical ? "bg-danger" : 
                                                    incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.High ? "bg-warning" : 
                                                    incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.Medium ? "bg-info" : "bg-secondary")">
                                                    <span data-i18n="enum.IncidentSeverity.@incident.Severity">@incident.Severity</span>
                                                </span>
                                            </td>
                                            <td>@(incident.Description ?? "-")</td>
                                            <td>@incident.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @(incident.Status == SchoolKeeper.Models.Enums.IncidentStatus.Active ? "bg-warning" : "bg-success")">
                                                    <span data-i18n="enum.IncidentStatus.@incident.Status">@incident.Status</span>
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-page="/Incidents/Details" asp-route-id="@incident.Id" class="btn btn-sm btn-info" data-i18n="common.details">Деталі</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted" data-i18n="teacher.emptyIncidents">Немає інцидентів</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
