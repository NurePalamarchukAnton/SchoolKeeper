@page
@model SchoolKeeper.Pages.Teacher.IndexModel
@{
    ViewData["Title"] = "Панель вчителя";
}

<div class="container-fluid">
    <h1 class="mb-4">Панель вчителя</h1>

    <!-- Вкладки -->
    <ul class="nav nav-tabs mb-4" id="teacherTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="students-tab" data-bs-toggle="tab" data-bs-target="#students" type="button" role="tab">
                Учні (@Model.Students.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="parents-tab" data-bs-toggle="tab" data-bs-target="#parents" type="button" role="tab">
                Батьки (@Model.Parents.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="incidents-tab" data-bs-toggle="tab" data-bs-target="#incidents" type="button" role="tab">
                Інциденти (@Model.Incidents.Count)
            </button>
        </li>
    </ul>

    <!-- Контент вкладок -->
    <div class="tab-content" id="teacherTabContent">
        <!-- Вкладка Учні -->
        <div class="tab-pane fade show active" id="students" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Мої учні</h5>
                </div>
                <div class="card-body">
                    @if (Model.Students.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>ПІБ</th>
                                        <th>Email</th>
                                        <th>Телефон</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model.Students)
                                    {
                                        <tr>
                                            <td>@student.FullName</td>
                                            <td>@student.Email</td>
                                            <td>@(student.PhoneNumber ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">У вас поки немає учнів</p>
                    }
                </div>
            </div>
        </div>

        <!-- Вкладка Батьки -->
        <div class="tab-pane fade" id="parents" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Батьки моїх учнів</h5>
                </div>
                <div class="card-body">
                    @if (Model.Parents.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>ПІБ</th>
                                        <th>Email</th>
                                        <th>Телефон</th>
                                        <th>Діти</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var parent in Model.Parents)
                                    {
                                        <tr>
                                            <td>@parent.FullName</td>
                                            <td>@parent.Email</td>
                                            <td>@(parent.PhoneNumber ?? "-")</td>
                                            <td>
                                                @if (parent.ChildrenNames.Any())
                                                {
                                                    <span>@string.Join(", ", parent.ChildrenNames)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Немає інформації про батьків</p>
                    }
                </div>
            </div>
        </div>

        <!-- Вкладка Інциденти -->
        <div class="tab-pane fade" id="incidents" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Інциденти</h5>
                </div>
                <div class="card-body">
                    @if (Model.Incidents.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Тип</th>
                                        <th>Серйозність</th>
                                        <th>Опис</th>
                                        <th>Дата</th>
                                        <th>Статус</th>
                                        <th>Дії</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var incident in Model.Incidents)
                                    {
                                        <tr>
                                            <td>@incident.IncidentType</td>
                                            <td>
                                                <span class="badge @(incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.Critical ? "bg-danger" : 
                                                    incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.High ? "bg-warning" : 
                                                    incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.Medium ? "bg-info" : "bg-secondary")">
                                                    @incident.Severity
                                                </span>
                                            </td>
                                            <td>@(incident.Description ?? "-")</td>
                                            <td>@incident.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @(incident.Status == SchoolKeeper.Models.Enums.IncidentStatus.Active ? "bg-warning" : "bg-success")">
                                                    @incident.Status
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-page="/Incidents/Details" asp-route-id="@incident.Id" class="btn btn-sm btn-info">Деталі</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Немає інцидентів</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

