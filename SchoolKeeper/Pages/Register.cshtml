@page
@model SchoolKeeper.Pages.RegisterModel
@{
    ViewData["Title"] = "Реєстрація";
    ViewData["I18nPage"] = "register";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-center mb-4" data-i18n="register.heading">Реєстрація</h2>
                
                <div id="errorAlert" class="alert alert-danger" role="alert" style="display: none;">
                    <span id="errorMessage"></span>
                </div>

                <div id="successAlert" class="alert alert-success" role="alert" style="display: none;">
                    <span id="successMessage"></span>
                </div>

                <form id="registerForm">
                    <div class="mb-3">
                        <label for="fullName" class="form-label" data-i18n="register.fullName">Повне ім'я</label>
                        <input type="text" class="form-control" id="fullName" name="fullName" required>
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" required>
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label" data-i18n="register.password">Пароль</label>
                        <input type="password" class="form-control" id="password" name="password" required>
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label" data-i18n="register.confirmPassword">Підтвердження пароля</label>
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label for="schoolId" class="form-label" data-i18n="register.school">Школа</label>
                        <select class="form-select" id="schoolId" name="schoolId" required>
                            <option value="" data-i18n="register.selectSchool">Оберіть школу</option>
                            @foreach (var school in Model.Schools)
                            {
                                <option value="@school.Id">@school.Name</option>
                            }
                        </select>
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="mb-3">
                        <label for="role" class="form-label" data-i18n="register.role">Роль</label>
                        <select class="form-select" id="role" name="role" required>
                            <option value="0" data-i18n="register.roleAdmin">Адміністратор</option>
                            <option value="1" data-i18n="register.roleSecurity">Охорона</option>
                            <option value="2" data-i18n="register.roleTeacher">Вчитель</option>
                            <option value="3" data-i18n="register.roleParent">Батько</option>
                            <option value="4" data-i18n="register.roleStudent">Студент</option>
                        </select>
                        <div class="invalid-feedback"></div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary" id="registerBtn" data-i18n="register.submit">Зареєструватися</button>
                    </div>
                </form>

                <div class="text-center mt-3">
                    <p><span data-i18n="register.haveAccount">Вже маєте акаунт?</span> <a asp-page="/Login" data-i18n="register.loginLink">Увійти</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function skT(key, fallback) {
            var sk = window.SchoolKeeperI18n;
            return sk ? sk.t(key) : fallback;
        }
        document.getElementById('registerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const fullName = document.getElementById('fullName').value;
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const schoolId = parseInt(document.getElementById('schoolId').value);
            const role = parseInt(document.getElementById('role').value);
            
            const errorAlert = document.getElementById('errorAlert');
            const errorMessage = document.getElementById('errorMessage');
            const successAlert = document.getElementById('successAlert');
            const successMessage = document.getElementById('successMessage');
            const registerBtn = document.getElementById('registerBtn');
            
            // Валідація паролів
            if (password !== confirmPassword) {
                errorMessage.textContent = skT('register.errMismatch', 'Паролі не співпадають.');
                errorAlert.style.display = 'block';
                successAlert.style.display = 'none';
                return;
            }
            
            if (password.length < 6) {
                errorMessage.textContent = skT('register.errShort', 'Пароль повинен містити мінімум 6 символів.');
                errorAlert.style.display = 'block';
                successAlert.style.display = 'none';
                return;
            }
            
            // Приховуємо помилки
            errorAlert.style.display = 'none';
            successAlert.style.display = 'none';
            registerBtn.disabled = true;
            registerBtn.textContent = skT('register.submitting', 'Реєстрація...');
            
            try {
                const response = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ 
                        fullName, 
                        email, 
                        password, 
                        schoolId, 
                        role 
                    })
                });
                
                const data = await response.json();
                
                if (response.ok && data.statusCode === 200) {
                    // Показуємо успіх
                    successMessage.textContent = data.message || skT('register.successDefault', 'Реєстрація успішна! Перенаправлення на сторінку входу...');
                    successAlert.style.display = 'block';
                    
                    // Перенаправляємо на сторінку входу через 2 секунди
                    setTimeout(() => {
                        window.location.href = '/Login';
                    }, 2000);
                } else {
                    // Показуємо помилку
                    errorMessage.textContent = data.message || skT('register.errGeneric', 'Помилка реєстрації. Спробуйте ще раз.');
                    errorAlert.style.display = 'block';
                }
            } catch (error) {
                errorMessage.textContent = skT('register.errNetwork', 'Помилка з\'єднання з сервером.');
                errorAlert.style.display = 'block';
            } finally {
                registerBtn.disabled = false;
                registerBtn.textContent = skT('register.submit', 'Зареєструватися');
            }
        });
        document.addEventListener('schoolkeeper:langchange', function () {
            var btn = document.getElementById('registerBtn');
            if (btn && !btn.disabled) btn.textContent = skT('register.submit', 'Зареєструватися');
        });
    </script>
}

