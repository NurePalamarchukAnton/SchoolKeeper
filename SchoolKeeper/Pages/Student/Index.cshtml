@page
@model SchoolKeeper.Pages.Student.IndexModel
@{
    ViewData["Title"] = "Панель учня";
    ViewData["I18nPage"] = "student";
}

<div class="container-fluid">
    <h1 class="mb-4" data-i18n="student.title">Панель учня</h1>

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title" data-i18n="student.card.myIncidents">Мої інциденти</h5>
                    <h2 class="mb-0">@Model.TotalIncidentsCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title" data-i18n="student.card.activeIncidents">Активні інциденти</h5>
                    <h2 class="mb-0">@Model.ActiveIncidentsCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title" data-i18n="student.card.teachers">Мої вчителі</h5>
                    <h2 class="mb-0">@Model.Teachers.Count</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-people me-2" viewBox="0 0 16 16">
                            <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1L7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.629 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002-.024.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a5.88 5.88 0 0 0-1.23-.247A7.35 7.35 0 0 0 5 9c-4 0-5 3-5 4 0 .667.333 1 1 1h4.216A2.238 2.238 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816M4.92 10A5.493 5.493 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275zM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4"/>
                        </svg>
                        <span data-i18n="student.teachersSection">Мої вчителі</span>
                    </h4>
                </div>
                <div class="card-body">
                    @if (Model.Teachers.Any())
                    {
                        <div class="row">
                            @foreach (var teacher in Model.Teachers)
                            {
                                <div class="col-md-4 col-lg-3 mb-3">
                                    <div class="card h-100 border-primary">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-circle me-2" viewBox="0 0 16 16">
                                                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                                                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                                                </svg>
                                                @teacher.FullName
                                            </h5>
                                            <p class="card-text mb-2">
                                                <small class="text-muted">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope me-1" viewBox="0 0 16 16">
                                                        <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm1.885.511a1.745 1.745 0 0 1 .435-.41l1.602-1.135A2.5 2.5 0 0 1 4.313 3h7.374c.42 0 .816.105 1.183.286l1.603 1.135a1.745 1.745 0 0 1 .435.41l1.56 1.56a.5.5 0 0 1-.707.707l-1.56-1.56a1.745 1.745 0 0 1-.41-.435L12.313 4.5H3.687l-.75 1.142a1.745 1.745 0 0 1-.41.435l-1.56 1.56a.5.5 0 1 1-.707-.707z"/>
                                                    </svg>
                                                    @teacher.Email
                                                </small>
                                            </p>
                                            @if (!string.IsNullOrEmpty(teacher.PhoneNumber))
                                            {
                                                <p class="card-text mb-0">
                                                    <small class="text-muted">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone me-1" viewBox="0 0 16 16">
                                                            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122L9.78 10.5a.678.678 0 0 1-.58-.122l-2.307-1.794a.678.678 0 0 0-.58-.122L5.5 8.22a.678.678 0 0 1-.122-.58l.5-2.307a.678.678 0 0 0-.122-.58L3.654 1.328z"/>
                                                        </svg>
                                                        @teacher.PhoneNumber
                                                    </small>
                                                </p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <p class="mb-0" data-i18n="student.emptyTeachers">У вас поки що немає призначених вчителів.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle me-2" viewBox="0 0 16 16">
                            <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.146.146 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.163.163 0 0 1-.054.06.116.116 0 0 1-.066.017H1.146a.115.115 0 0 1-.066-.017.163.163 0 0 1-.054-.06.176.176 0 0 1 .002-.183L7.884 2.073a.147.147 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566z"/>
                            <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
                        </svg>
                        <span data-i18n="student.incidentsSection">Мої інциденти</span>
                    </h4>
                </div>
                <div class="card-body">
                    @if (Model.MyIncidents.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th data-i18n="admin.th.id">ID</th>
                                        <th data-i18n="student.th.incidentType">Тип інциденту</th>
                                        <th data-i18n="incidents.th.severity">Серйозність</th>
                                        <th data-i18n="admin.lbl.description">Опис</th>
                                        <th data-i18n="incidents.th.date">Дата</th>
                                        <th data-i18n="incidents.th.status">Статус</th>
                                        <th data-i18n="incidents.th.actions">Дії</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var incident in Model.MyIncidents)
                                    {
                                        <tr>
                                            <td>@incident.Id</td>
                                            <td>@incident.IncidentType</td>
                                            <td>
                                                <span class="badge @(incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.Critical ? "bg-danger" : incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.High ? "bg-warning" : incident.Severity == SchoolKeeper.Models.Enums.IncidentSeverity.Medium ? "bg-info" : "bg-secondary")">
                                                    <span data-i18n="enum.IncidentSeverity.@incident.Severity">@incident.Severity</span>
                                                </span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(incident.Description))
                                                {
                                                    <span title="@incident.Description">
                                                        @(incident.Description.Length > 50 ? incident.Description.Substring(0, 50) + "..." : incident.Description)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted" data-i18n="common.noDescription">Немає опису</span>
                                                }
                                            </td>
                                            <td>@incident.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @(incident.Status == SchoolKeeper.Models.Enums.IncidentStatus.Active ? "bg-danger" : "bg-success")">
                                                    <span data-i18n="enum.IncidentStatus.@incident.Status">@incident.Status</span>
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-page="/Incidents/Details" asp-route-id="@incident.Id" class="btn btn-sm btn-info" data-i18n="common.details">Деталі</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <p class="mb-0" data-i18n="student.emptyIncidents">У вас поки що немає інцидентів з вашою участю.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
